<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--=======STATE ADV SEND EMAIL=========-->
        <record id="email_template_draft" model="mail.template">
            <field name="name">Courrier: Convention d'achat</field>
            <field name="model_id" ref="thorium.model_purchase_requisition"/>
            <field name="subject">Convention d'achat {{object.name}} en attente de vérification</field>
            <field name="email_from">{{(object.company_id.email_formatted or user.email_formatted)}}</field>
            <field name="email_to">{{user.email_formatted}}</field>
            <field name="auto_delete" eval="True"/>

            <field name="body_html" type="html">
                <div style="background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                    <table style="width:1000px;margin:5px auto;">
                        <tbody>
                            <tr>
                                <td>
                                    <a href="/">
                                        <img src="/web/binary/company_logo"
                                             style="vertical-align:baseline;max-width:100px;"
                                             class="d-block mx-auto o_we_selected_image"
                                             data-original-title="${object.company_id.name}"
                                             title="${object.company_id.name}" aria-describedby="PIGELEC"/>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;">
                        <tbody>
                            <tr>
                                <td style="padding:15px 20px 10px 20px;">
                                    <div>
                                        <h2>Bonjour Monsieur/Madame</h2>
                                        <br/>
                                        <p style="color:#9E588B;">Vous avez reçu un courrier électronique important
                                            nécessitant votre attention sur une nouvelle convention d'achat.
                                            <ul>
                                                <li>Référence' :
                                                    <t t-out="object.name"/>
                                                </li>
                                                <li>Fournisseur :
                                                    <t t-out="object.vendor_id.name"/>
                                                </li>
                                                <li>Type de convention :
                                                    <t t-esc="dict(object._fields['requisition_type'].selection).get(object.requisition_type)"/>
                                                </li>

                                            </ul>
                                        </p>
                                    </div>
                                    <h3 style="color:#9E588B;">Cordialement.</h3>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>

        <!--=======STATE DEPLOIEMENT SEND EMAIL=========-->
        <record id="email_template_submit" model="mail.template">
            <field name="name">Courrier: Convention d'achat</field>
            <field name="model_id" ref="thorium.model_purchase_requisition"/>
            <field name="subject">Convention d'achat {{object.name}} en attente de vérification</field>
            <field name="email_from">{{(object.company_id.email_formatted or user.email_formatted)}}</field>
            <field name="email_to">{{user.email_formatted}}</field>
            <field name="email_cc">{{""}}</field>
            <field name="auto_delete" eval="True"/>

            <field name="body_html" type="html">
                <div style="background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                    <table style="width:1000px;margin:5px auto;">
                        <tbody>
                            <tr>
                                <td>
                                    <a href="/">
                                        <img src="/web/binary/company_logo"
                                             style="vertical-align:baseline;max-width:100px;"
                                             class="d-block mx-auto o_we_selected_image"
                                             data-original-title="${object.company_id.name}"
                                             title="${object.company_id.name}" aria-describedby="PIGELEC"/>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;">
                        <tbody>
                            <tr>
                                <td style="padding:15px 20px 10px 20px;">
                                    <div>
                                        <h2>Bonjour Monsieur/Madame</h2>
                                        <br/>
                                        <p style="color:#9E588B;">Vous avez reçu un courrier électronique important
                                            nécessitant votre attention.
                                            <ul>
                                                <li>Référence' :
                                                    <t t-out="object.name"/>
                                                </li>
                                                <li>Fournisseur :
                                                    <t t-out="object.vendor_id.name"/>
                                                </li>
                                                <li>Type de convention :
                                                    <t t-esc="dict(object._fields['requisition_type'].selection).get(object.requisition_type)"/>
                                                </li>

                                            </ul>
                                        </p>
                                    </div>
                                    <h3 style="color:#9E588B;">Cordialement.</h3>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>
    </data>
</odoo>