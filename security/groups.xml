<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="thorium_category">
        <field name="name">THORIUM ACCESS</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_thorium_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="thorium.thorium_category"/>
    </record>

    <record id="group_thorium_respo" model="res.groups">
        <field name="name">Responsable</field>
        <field name="implied_ids" eval="[(4, ref('thorium.group_thorium_user'))]"/>
        <field name="category_id" ref="thorium.thorium_category"/>
    </record>

    <record id="group_thorium_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="thorium.thorium_category"/>
        <field name="implied_ids" eval="[(4, ref('thorium.group_thorium_respo'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>

    <record id="base.default_user" model="res.users">
        <field name="groups_id" eval="[(4, ref('thorium.group_thorium_manager'))]"/>
    </record>

