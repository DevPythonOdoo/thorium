<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_edi_purchase_import" model="mail.template">
            <field name="name">Achat : Demande de devis inter.</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">{{ object.company_id.name }} Order (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Envoyé manuellement au fournisseur pour demander un devis</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-out="object.partner_id.name or ''">Brandon Freeman</t>
                        <t t-if="object.partner_id.parent_id">
                            (<t t-out="object.partner_id.parent_id.name or ''">Azure Interior</t>)
                        </t>
                        <br/>
                        <br/>
                        Voici en pièce jointe une demande de devis
                        <span style="font-weight:bold;" t-out="object.name or ''">P00015</span>
                        <t t-if="object.partner_ref">
                            avec référence:
                            <t t-out="object.partner_ref or ''">REF_XXX</t>
                        </t>
                        from <t t-out="object.company_id.name or ''">YourCompany</t>.
                        <br/>
                        <br/>
                        Si vous avez des questions, n'hésitez pas à nous contacter.
                        <br/>
                        <br/>
                        Cordialement,
                        <t t-if="not is_html_empty(object.user_id.signature)">
                            <br/>
                            <br/>
                            <t t-out="object.user_id.signature or ''">--<br/>Mitchell Admin
                            </t>
                        </t>
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('thorium.action_report_purchase_order_import'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>


        #---------------------------------------------

        <record id="email_template_edi_purchase_done_import" model="mail.template">
            <field name="name">Achat : Bon de commande inter.</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">{{ object.company_id.name }} Commande (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Envoyé au fournisseur avec le bon de commande en pièce jointe</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        <t t-out="object.partner_id.name or ''">Brandon Freeman</t>
                        <t t-if="object.partner_id.parent_id">
                            (<t t-out="object.partner_id.parent_id.name or ''">Azure Interior</t>)
                        </t>
                        <br/>
                        <br/>
                        Voici en pièce jointe un bon de commande
                        <span style="font-weight:bold;" t-out="object.name or ''">P00015</span>
                        <t t-if="object.partner_ref">
                            avec référence:
                            <t t-out="object.partner_ref or ''">REF_XXX</t>
                        </t>
                        s'élevant à
                        <span style="font-weight:bold;"
                              t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00
                        </span>
                        depuis <t t-out="object.company_id.name or ''">YourCompany</t>.
                        <br/>
                        <br/>
                        <t t-if="object.date_planned">
                            La réception est attendue pour <span style="font-weight:bold;"
                                                                 t-out="format_date(object.date_planned) or ''">
                            05/05/2021</span>.
                            <br/>
                            <br/>
                            Pourriez-vous s'il vous plaît accuser réception de cette commande ?
                        </t>
                        <t t-if="not is_html_empty(object.user_id.signature)">
                            <br/>
                            <br/>
                            <t t-out="object.user_id.signature or ''">--<br/>Mitchell Admin
                            </t>
                        </t>
                        <br/>
                        <br/>
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('thorium.report_purchase_quotation_import'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>